<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{5A43B545-F091-413C-987F-D9F2CC2201C0}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Landscapes\CloudySky.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Gems\SuperGems.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Weather\Snow.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Weather\WeatherEffects.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="CloudySky">
        <MSBuild Projects="Landscapes\CloudySky.dproj"/>
    </Target>
    <Target Name="CloudySky:Clean">
        <MSBuild Projects="Landscapes\CloudySky.dproj" Targets="Clean"/>
    </Target>
    <Target Name="CloudySky:Make">
        <MSBuild Projects="Landscapes\CloudySky.dproj" Targets="Make"/>
    </Target>
    <Target Name="SuperGems">
        <MSBuild Projects="Gems\SuperGems.dproj"/>
    </Target>
    <Target Name="SuperGems:Clean">
        <MSBuild Projects="Gems\SuperGems.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SuperGems:Make">
        <MSBuild Projects="Gems\SuperGems.dproj" Targets="Make"/>
    </Target>
    <Target Name="Snow">
        <MSBuild Projects="Weather\Snow.dproj"/>
    </Target>
    <Target Name="Snow:Clean">
        <MSBuild Projects="Weather\Snow.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Snow:Make">
        <MSBuild Projects="Weather\Snow.dproj" Targets="Make"/>
    </Target>
    <Target Name="WeatherEffects">
        <MSBuild Projects="Weather\WeatherEffects.dproj"/>
    </Target>
    <Target Name="WeatherEffects:Clean">
        <MSBuild Projects="Weather\WeatherEffects.dproj" Targets="Clean"/>
    </Target>
    <Target Name="WeatherEffects:Make">
        <MSBuild Projects="Weather\WeatherEffects.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="CloudySky;SuperGems;Snow;WeatherEffects"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="CloudySky:Clean;SuperGems:Clean;Snow:Clean;WeatherEffects:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="CloudySky:Make;SuperGems:Make;Snow:Make;WeatherEffects:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
