<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9164AF8A-55F5-489C-A0AE-0034D6BE1D60}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Projects\AstroSceneC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Addons\StarProj\StarViewerC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Addons\Starbox\GenStarc.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Addons\FermiPX\Starnetc.cbproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="AstroSceneC">
        <MSBuild Projects="Projects\AstroSceneC.cbproj"/>
    </Target>
    <Target Name="AstroSceneC:Clean">
        <MSBuild Projects="Projects\AstroSceneC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="AstroSceneC:Make">
        <MSBuild Projects="Projects\AstroSceneC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="StarViewerC">
        <MSBuild Projects="Addons\StarProj\StarViewerC.cbproj"/>
    </Target>
    <Target Name="StarViewerC:Clean">
        <MSBuild Projects="Addons\StarProj\StarViewerC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="StarViewerC:Make">
        <MSBuild Projects="Addons\StarProj\StarViewerC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="GenStarc">
        <MSBuild Projects="Addons\Starbox\GenStarc.cbproj"/>
    </Target>
    <Target Name="GenStarc:Clean">
        <MSBuild Projects="Addons\Starbox\GenStarc.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="GenStarc:Make">
        <MSBuild Projects="Addons\Starbox\GenStarc.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Starnetc">
        <MSBuild Projects="Addons\FermiPX\Starnetc.cbproj"/>
    </Target>
    <Target Name="Starnetc:Clean">
        <MSBuild Projects="Addons\FermiPX\Starnetc.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="Starnetc:Make">
        <MSBuild Projects="Addons\FermiPX\Starnetc.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="AstroSceneC;StarViewerC;GenStarc;Starnetc"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="AstroSceneC:Clean;StarViewerC:Clean;GenStarc:Clean;Starnetc:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="AstroSceneC:Make;StarViewerC:Make;GenStarc:Make;Starnetc:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
