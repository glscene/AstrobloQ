<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{D32D7D7A-5417-4026-8B06-02DEC16C8F0B}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ScatterPlot.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="VolumeRender.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ScatterPlot">
        <MSBuild Projects="ScatterPlot.dproj"/>
    </Target>
    <Target Name="ScatterPlot:Clean">
        <MSBuild Projects="ScatterPlot.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ScatterPlot:Make">
        <MSBuild Projects="ScatterPlot.dproj" Targets="Make"/>
    </Target>
    <Target Name="VolumeRender">
        <MSBuild Projects="VolumeRender.dproj"/>
    </Target>
    <Target Name="VolumeRender:Clean">
        <MSBuild Projects="VolumeRender.dproj" Targets="Clean"/>
    </Target>
    <Target Name="VolumeRender:Make">
        <MSBuild Projects="VolumeRender.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ScatterPlot;VolumeRender"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ScatterPlot:Clean;VolumeRender:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ScatterPlot:Make;VolumeRender:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
