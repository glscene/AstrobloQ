<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{23E9AF3B-85A5-4EAB-84D1-BA6BE77370FA}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Geobloq\Geobloq.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Geobloq\Geobloqc.cbproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Geobloq">
        <MSBuild Projects="Geobloq\Geobloq.dproj"/>
    </Target>
    <Target Name="Geobloq:Clean">
        <MSBuild Projects="Geobloq\Geobloq.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Geobloq:Make">
        <MSBuild Projects="Geobloq\Geobloq.dproj" Targets="Make"/>
    </Target>
    <Target Name="Geobloqc">
        <MSBuild Projects="Geobloq\Geobloqc.cbproj"/>
    </Target>
    <Target Name="Geobloqc:Clean">
        <MSBuild Projects="Geobloq\Geobloqc.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="Geobloqc:Make">
        <MSBuild Projects="Geobloq\Geobloqc.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Geobloq;Geobloqc"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Geobloq:Clean;Geobloqc:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Geobloq:Make;Geobloqc:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
