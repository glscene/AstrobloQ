<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{484ED049-786A-4E29-A796-830C7D73BFD0}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="SpaceNota.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="SpaceNota_ru.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SpaceNota">
        <MSBuild Projects="SpaceNota.dproj"/>
    </Target>
    <Target Name="SpaceNota:Clean">
        <MSBuild Projects="SpaceNota.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SpaceNota:Make">
        <MSBuild Projects="SpaceNota.dproj" Targets="Make"/>
    </Target>
    <Target Name="SpaceNota_ru">
        <MSBuild Projects="SpaceNota_ru.dproj"/>
    </Target>
    <Target Name="SpaceNota_ru:Clean">
        <MSBuild Projects="SpaceNota_ru.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SpaceNota_ru:Make">
        <MSBuild Projects="SpaceNota_ru.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SpaceNota;SpaceNota_ru"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SpaceNota:Clean;SpaceNota_ru:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SpaceNota:Make;SpaceNota_ru:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
