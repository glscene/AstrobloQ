    </Target>
    <Target Name="Geobloq:Clean">
        <MSBuild Projects="Geobloq\Geobloq.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Geobloq:Make">
        <MSBuild Projects="Geobloq\Geobloq.dproj" Targets="Make"/>
