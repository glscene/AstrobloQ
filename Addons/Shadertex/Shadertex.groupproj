<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{13A0F147-29FD-4F61-85EF-0A0616846651}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Bumps\BumpSmoke.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Bumps\BumpEarth.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="BumpSmoke">
        <MSBuild Projects="Bumps\BumpSmoke.dproj"/>
    </Target>
    <Target Name="BumpSmoke:Clean">
        <MSBuild Projects="Bumps\BumpSmoke.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BumpSmoke:Make">
        <MSBuild Projects="Bumps\BumpSmoke.dproj" Targets="Make"/>
    </Target>
    <Target Name="BumpEarth">
        <MSBuild Projects="Bumps\BumpEarth.dproj"/>
    </Target>
    <Target Name="BumpEarth:Clean">
        <MSBuild Projects="Bumps\BumpEarth.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BumpEarth:Make">
        <MSBuild Projects="Bumps\BumpEarth.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="BumpSmoke;BumpEarth"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="BumpSmoke:Clean;BumpEarth:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="BumpSmoke:Make;BumpEarth:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
