<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{34D46BB1-B6F4-4B95-AAE8-B07CDB10AAC1}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Stellarfon.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Stellarfonx.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="source\Midikeys.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Stellarfon">
        <MSBuild Projects="Stellarfon.dproj"/>
    </Target>
    <Target Name="Stellarfon:Clean">
        <MSBuild Projects="Stellarfon.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Stellarfon:Make">
        <MSBuild Projects="Stellarfon.dproj" Targets="Make"/>
    </Target>
    <Target Name="Stellarfonx">
        <MSBuild Projects="Stellarfonx.dproj"/>
    </Target>
    <Target Name="Stellarfonx:Clean">
        <MSBuild Projects="Stellarfonx.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Stellarfonx:Make">
        <MSBuild Projects="Stellarfonx.dproj" Targets="Make"/>
    </Target>
    <Target Name="Midikeys">
        <MSBuild Projects="source\Midikeys.dproj"/>
    </Target>
    <Target Name="Midikeys:Clean">
        <MSBuild Projects="source\Midikeys.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Midikeys:Make">
        <MSBuild Projects="source\Midikeys.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Stellarfon;Stellarfonx;Midikeys"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Stellarfon:Clean;Stellarfonx:Clean;Midikeys:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Stellarfon:Make;Stellarfonx:Make;Midikeys:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
