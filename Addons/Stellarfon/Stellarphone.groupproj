<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{484ED049-786A-4E29-A796-830C7D73BFD0}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Stellarfon.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Stellarfon_ru.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Stellarfon">
        <MSBuild Projects="Stellarfon.dproj"/>
    </Target>
    <Target Name="Stellarfon:Clean">
        <MSBuild Projects="Stellarfon.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Stellarfon:Make">
        <MSBuild Projects="Stellarfon.dproj" Targets="Make"/>
    </Target>
    <Target Name="Stellarfon_ru">
        <MSBuild Projects="Stellarfon_ru.dproj"/>
    </Target>
    <Target Name="Stellarfon_ru:Clean">
        <MSBuild Projects="Stellarfon_ru.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Stellarfon_ru:Make">
        <MSBuild Projects="Stellarfon_ru.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Stellarfon;Stellarfon_ru"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Stellarfon:Clean;Stellarfon_ru:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Stellarfon:Make;Stellarfon_ru:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
