        <Projects Include="LandFlight\LandTexture.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="StarsysGen\StarsysGen.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="StarProj\StarProj.dproj">
            <Dependencies/>
        </Projects>
