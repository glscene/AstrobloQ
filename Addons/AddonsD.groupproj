            <Dependencies/>
        </Projects>
        <Projects Include="FermiPX\Starnetx.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ApexD">
        <MSBuild Projects="Apex\ApexD.dproj"/>
    </Target>
    <Target Name="ApexD:Clean">
        <MSBuild Projects="Apex\ApexD.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ApexD:Make">
        <MSBuild Projects="Apex\ApexD.dproj" Targets="Make"/>
    </Target>
    <Target Name="LandTexture">
        <MSBuild Projects="LandFlight\LandTexture.dproj"/>
    </Target>
    <Target Name="LandTexture:Clean">
        <MSBuild Projects="LandFlight\LandTexture.dproj" Targets="Clean"/>
    </Target>
    <Target Name="LandTexture:Make">
        <MSBuild Projects="LandFlight\LandTexture.dproj" Targets="Make"/>
    </Target>
    <Target Name="StarsysGen">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj"/>
    </Target>
    <Target Name="StarsysGen:Clean">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarsysGen:Make">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj" Targets="Make"/>
    </Target>
    <Target Name="StarProj">
        <MSBuild Projects="StarProj\StarProj.dproj"/>
    </Target>
    <Target Name="StarProj:Clean">
        <MSBuild Projects="StarProj\StarProj.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarProj:Make">
        <MSBuild Projects="StarProj\StarProj.dproj" Targets="Make"/>
    </Target>
    <Target Name="Starnets">
        <MSBuild Projects="FermiPX\Starnets.dproj"/>
    </Target>
    <Target Name="Starnets:Clean">
        <MSBuild Projects="FermiPX\Starnets.dproj" Targets="Clean"/>
