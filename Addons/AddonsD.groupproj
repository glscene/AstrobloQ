    </Target>
    <Target Name="Starnetx:Clean">
        <MSBuild Projects="FermiPX\Starnetx.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Starnetx:Make">
        <MSBuild Projects="FermiPX\Starnetx.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ApexD;LandTexture;StarsysGen;StarProj;Starnets;Starnetx"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ApexD:Clean;LandTexture:Clean;StarsysGen:Clean;StarProj:Clean;Starnets:Clean;Starnetx:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ApexD:Make;LandTexture:Make;StarsysGen:Make;StarProj:Make;Starnets:Make;Starnetx:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
