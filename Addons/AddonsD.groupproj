<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{34D46BB1-B6F4-4B95-AAE8-B07CDB10AAC1}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="StarProj\StarProj.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FermiPX\StarCells.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="StarsysGen\StarsysGen.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FermiPX\StarCellx.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="StarProj">
        <MSBuild Projects="StarProj\StarProj.dproj"/>
    </Target>
    <Target Name="StarProj:Clean">
        <MSBuild Projects="StarProj\StarProj.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarProj:Make">
        <MSBuild Projects="StarProj\StarProj.dproj" Targets="Make"/>
    </Target>
    <Target Name="StarCells">
        <MSBuild Projects="FermiPX\StarCells.dproj"/>
    </Target>
    <Target Name="StarCells:Clean">
        <MSBuild Projects="FermiPX\StarCells.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarCells:Make">
        <MSBuild Projects="FermiPX\StarCells.dproj" Targets="Make"/>
    </Target>
    <Target Name="StarsysGen">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj"/>
    </Target>
    <Target Name="StarsysGen:Clean">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarsysGen:Make">
        <MSBuild Projects="StarsysGen\StarsysGen.dproj" Targets="Make"/>
    </Target>
    <Target Name="StarCellx">
        <MSBuild Projects="FermiPX\StarCellx.dproj"/>
    </Target>
    <Target Name="StarCellx:Clean">
        <MSBuild Projects="FermiPX\StarCellx.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StarCellx:Make">
        <MSBuild Projects="FermiPX\StarCellx.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="StarProj;StarCells;StarsysGen;StarCellx"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="StarProj:Clean;StarCells:Clean;StarsysGen:Clean;StarCellx:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="StarProj:Make;StarCells:Make;StarsysGen:Make;StarCellx:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
