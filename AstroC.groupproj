<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9164AF8A-55F5-489C-A0AE-0034D6BE1D60}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Projects\AstroViewerC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Projects\UniversumC.cbproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="AstroViewerC">
        <MSBuild Projects="Projects\AstroViewerC.cbproj"/>
    </Target>
    <Target Name="AstroViewerC:Clean">
        <MSBuild Projects="Projects\AstroViewerC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="AstroViewerC:Make">
        <MSBuild Projects="Projects\AstroViewerC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="UniversumC">
        <MSBuild Projects="Projects\UniversumC.cbproj"/>
    </Target>
    <Target Name="UniversumC:Clean">
        <MSBuild Projects="Projects\UniversumC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="UniversumC:Make">
        <MSBuild Projects="Projects\UniversumC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="AstroViewerC;UniversumC"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="AstroViewerC:Clean;UniversumC:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="AstroViewerC:Make;UniversumC:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
