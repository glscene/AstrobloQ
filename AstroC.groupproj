<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9164AF8A-55F5-489C-A0AE-0034D6BE1D60}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Projects\LithosphereC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Projects\BiosphereC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Projects\AstroViewerC.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Projects\VirtualMilkyWayC.cbproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="LithosphereC">
        <MSBuild Projects="Projects\LithosphereC.cbproj"/>
    </Target>
    <Target Name="LithosphereC:Clean">
        <MSBuild Projects="Projects\LithosphereC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="LithosphereC:Make">
        <MSBuild Projects="Projects\LithosphereC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="BiosphereC">
        <MSBuild Projects="Projects\BiosphereC.cbproj"/>
    </Target>
    <Target Name="BiosphereC:Clean">
        <MSBuild Projects="Projects\BiosphereC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="BiosphereC:Make">
        <MSBuild Projects="Projects\BiosphereC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="AstroViewerC">
        <MSBuild Projects="Projects\AstroViewerC.cbproj"/>
    </Target>
    <Target Name="AstroViewerC:Clean">
        <MSBuild Projects="Projects\AstroViewerC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="AstroViewerC:Make">
        <MSBuild Projects="Projects\AstroViewerC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="VirtualMilkyWayC">
        <MSBuild Projects="Projects\VirtualMilkyWayC.cbproj"/>
    </Target>
    <Target Name="VirtualMilkyWayC:Clean">
        <MSBuild Projects="Projects\VirtualMilkyWayC.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="VirtualMilkyWayC:Make">
        <MSBuild Projects="Projects\VirtualMilkyWayC.cbproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="LithosphereC;BiosphereC;AstroViewerC;VirtualMilkyWayC"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="LithosphereC:Clean;BiosphereC:Clean;AstroViewerC:Clean;VirtualMilkyWayC:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="LithosphereC:Make;BiosphereC:Make;AstroViewerC:Make;VirtualMilkyWayC:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
